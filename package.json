{
  "name": "routing-api-client",
  "version": "0.1.0",
  "description": "Official Node.js client for the Routing API - Bank lookups, SWIFT codes, IBAN validation, OFAC screening",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "routing",
    "bank",
    "swift",
    "bic",
    "iban",
    "ofac",
    "compliance",
    "fintech",
    "banking"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/routing-api-client-js.git"
  },
  "homepage": "https://github.com/yourusername/routing-api-client-js#readme",
  "bugs": {
    "url": "https://github.com/yourusername/routing-api-client-js/issues"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
